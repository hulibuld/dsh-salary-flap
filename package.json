{
  "name": "dsh-salary-flap",
  "version": "1.0.0",
  "type": "module",
  "description": "工资跳板：挂在 DeepSeek Harness Web UI 上的翻牌工资看板，每 2 秒结算一次今天已经赚了多少钱。纯前端，无 Host 服务、无网络、配置存本地。",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/zh.json",
    "locale/en.json",
    "icon.svg",
    "lib/*",
    "window.html",
    "tools/selfcheck.mjs",
    "LICENSE",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [],
      "external": [],
      "immediately": true
    }
  },
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "client-plugin",
    "salary",
    "split-flap",
    "flip-clock",
    "widget",
    "overlay",
    "salary-counter"
  ],
  "license": "MIT",
  "engines": {
    "dsh": ">=0.2.0-rc.1 <0.3.0-0"
  },
  "author": "hulibuld",
  "homepage": "https://github.com/hulibuld/dsh-salary-flap#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hulibuld/dsh-salary-flap.git"
  },
  "bugs": {
    "url": "https://github.com/hulibuld/dsh-salary-flap/issues"
  },
  "scripts": {
    "selfcheck": "node tools/selfcheck.mjs"
  }
}
